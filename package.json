{
  "name": "dormpath",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/check-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:rules": "npx firebase-tools@15 emulators:exec --only firestore --project demo-dormpath \"node --test tests/rules.integration.js\"",
    "make-admin": "node scripts/admin/grant-admin.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
