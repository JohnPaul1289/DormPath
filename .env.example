# ==============================================================================
# DORMPATH ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.local` for local development.
# In Netlify production, add all variables under Site Configuration > Environment variables.
# NEVER commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND / CLIENT-SIDE FIREBASE (Vite public variables - bundled into client)
# Locate these in: Firebase Console > Project Settings > General > Your apps (Web)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# FRONTEND / APP CHECK (reCAPTCHA Enterprise public site key)
# Locate this in: Firebase Console > App Check > Apps > DormPath (Web)
# Leave blank during initial local setup until reCAPTCHA is registered.
# ------------------------------------------------------------------------------
VITE_APPCHECK_SITE_KEY=

# Optional: App Check debug token for localhost development
# (Set to true or a specific token generated by Firebase App Check debug provider)
# VITE_APPCHECK_DEBUG_TOKEN=

# ------------------------------------------------------------------------------
# BACKEND / SERVER-SIDE FIREBASE (Netlify Functions ONLY - NEVER prefix with VITE_)
# Used by Netlify Functions to verify session tokens via Google Identity Toolkit
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=

# Optional: Set to true once reCAPTCHA Enterprise and App Check are verified
# FIREBASE_APPCHECK_ENFORCE=false

# ------------------------------------------------------------------------------
# BACKEND / CLOUDINARY (Netlify Functions ONLY - NEVER prefix with VITE_)
# Locate these in: Cloudinary Console > Dashboard / API Keys & Settings
# Used to generate HMAC-SHA256 signatures for authenticated landlord photo uploads
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=dormpath_signed

# ------------------------------------------------------------------------------
# BACKEND / GROQ AI (Netlify Functions ONLY - NEVER prefix with VITE_)
# Get a free key at: https://console.groq.com/keys
# Powers DOMI AI Housing Assistant using fast Llama 3.3 server-side inference
# ------------------------------------------------------------------------------
GROQ_API_KEY=
